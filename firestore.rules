rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /omniUsers/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /omniMemories/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /omniChats/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /architecture_ia_africa_site/public_config {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.token.email == 'marioceatin@gmail.com';
    }
  }
}
